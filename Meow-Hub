local function hookHiddenAccessories()
	if hiddenAccessoriesHooked then return end
	hiddenAccessoriesHooked = true

	local function getFaceAssetsFolder()
		local ok, assets = pcall(function()
			return game:GetService("ReplicatedStorage"):WaitForChild("Assets", 10)
				:WaitForChild("FaceAssets", 10)
		end)
		return ok and assets or nil
	end

	local function getTextureFromAsset(asset)
		if not asset then return nil end
		if asset:IsA("Decal") then return asset.Texture end
		if asset:IsA("Texture") then return asset.Texture end
		if asset:IsA("ImageHandle") then return asset.Image end
		if asset:IsA("MeshPart") then
			local sa = asset:FindFirstChildOfClass("SurfaceAppearance")
			if sa then return sa.ColorMap end
		end
		for _, child in ipairs(asset:GetChildren()) do
			if child:IsA("Decal") then return child.Texture end
			if child:IsA("Texture") then return child.Texture end
			if child:IsA("ImageHandle") then return child.Image end
			if child:IsA("SurfaceAppearance") then return child.ColorMap end
		end
		return nil
	end

	local function applyFaceSwap(character, raceName)
		if not character then return end
		local head = character:FindFirstChild("Head")
		if not head then return end
		local race = RACES[raceName]
		if not race or not race.face then return end
		local faceAssets = getFaceAssetsFolder()
		if not faceAssets then return end

		for _, cat in ipairs(FACE_CATS) do
			if race.face[cat] and selectedFaceCats[cat] then
				local folder = faceAssets:FindFirstChild(cat)
				local asset = folder and folder:FindFirstChild(raceName)
				local tex = getTextureFromAsset(asset)
				if tex then
					for _, desc in ipairs(head:GetDescendants()) do
						if desc:IsA("Decal") and (desc.Name == cat or desc.Name == "face") then
							desc.Texture = tex
						end
					end
					local faceDecal = head:FindFirstChild("face")
					if faceDecal and faceDecal:IsA("Decal") then
						faceDecal.Texture = tex
					end
				end
			end
		end
	end

	local function applyHidden(character)
		if not character then return end
		if C.RACE == "" or not RACES[C.RACE] then return end
		local race = RACES[C.RACE]
		applyFaceSwap(character, C.RACE)

		if not selectedFaceCats["_accessories"] then return end
		local nameList = race.accNames or {}
		local meshList = race.accMeshes or {}
		if #nameList == 0 and #meshList == 0 then return end
		for _, obj in ipairs(character:GetDescendants()) do
			if obj:IsA("Accessory") then
				local shouldDestroy = false
				for _, name in ipairs(nameList) do
					if name ~= "" and obj.Name:find(name, 1, true) then
						shouldDestroy = true
						break
					end
				end
				if not shouldDestroy then
					local handle = obj:FindFirstChild("Handle")
					if handle then
						for _, meshId in ipairs(meshList) do
							if meshId ~= "" then
								local mesh = handle:FindFirstChildOfClass("SpecialMesh")
								if mesh and mesh.MeshId:find(meshId, 1, true) then
									shouldDestroy = true
									break
								end
								if handle:FindFirstChild("MeshPart") and handle.MeshPart.MeshId:find(meshId, 1, true) then
									shouldDestroy = true
									break
								end
							end
						end
					end
				end
				if shouldDestroy then
					obj:Destroy()
				end
			end
		end
	end
	local char = player.Character or player.CharacterAdded:Wait()
	applyHidden(char)
	player.CharacterAdded:Connect(function(c)
		task.wait(0.5)
		applyHidden(c)
	end)
end

