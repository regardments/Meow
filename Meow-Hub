local function clean(t)
	return t:gsub("<.->",""):gsub("%s+$",""):gsub("^%s+","")
end

local function applyGradient(lbl)
	if lbl:FindFirstChild("NameGradient") then lbl.NameGradient:Destroy() end
	if C.RANKS == "" or not RANKS[C.RANKS] then return end
	local grad = Instance.new("UIGradient")
	grad.Name = "NameGradient"
	grad.Rotation = 90
	local keypoints = {}
	for _, kp in ipairs(RANKS[C.RANKS]) do
		table.insert(keypoints, ColorSequenceKeypoint.new(kp[1], kp[2]))
	end
	grad.Color = ColorSequence.new(keypoints)
	grad.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,0), NumberSequenceKeypoint.new(1,0)})
	grad.Parent = lbl
end

local function spoof(lbl)
	if not lbl:IsA("TextLabel") or not lbl.Text then return end
	local txt = clean(lbl.Text)

	if C.TARGET_NAME ~= "" and (txt == C.TARGET_NAME or (#txt <= 20 and txt:find(C.TARGET_NAME, 1, true))) then
		if C.FAKE_NAME ~= "" then lbl.Text = C.FAKE_NAME end
		applyGradient(lbl)
		return
	end

	if C.REAL_GIVENNAME ~= "" and txt:find(C.REAL_GIVENNAME, 1, true) then
		if C.FAKE_GIVENNAME ~= "" then lbl.Text = C.FAKE_GIVENNAME end
		applyGradient(lbl)
		return
	end

	if C.REAL_GUILD ~= "" and txt:find(C.REAL_GUILD, 1, true) then
		if C.FAKE_GUILD ~= "" then lbl.Text = txt:gsub(C.REAL_GUILD, C.FAKE_GUILD, 1) end
		return
	end
	if C.REAL_ID_BLOCK ~= "" and txt:find(C.REAL_ID_BLOCK, 1, true) then
		local pat = C.REAL_ID_BLOCK:gsub("([%^%$%(%)%%%.%[%]%*%+%-%?])","%%%1")
		lbl.Text = txt:gsub(pat, C.FAKE_ID_BLOCK)
		return
	end
	if C.FAKE_DATE ~= "" and (txt:find("CE") or txt:find("Speed")) then
		lbl.Text = C.FAKE_DATE
		return
	end
	if C.FAKE_SESSION ~= "" and txt:find("%d+d") and txt:find("%d+h") and txt:find("%d+m") then
		lbl.Text = C.FAKE_SESSION
		return
	end
end

