local function saveConfig()
	if not writefile then return end
	local parts = {}
	for _, key in ipairs(CONFIG_KEYS) do
		table.insert(parts, C[key] or "")
	end
	writefile(CONFIG_PATH, table.concat(parts, "||"))
end

local function loadConfig()
	if not readfile or not isfile or not isfile(CONFIG_PATH) then return end
	local ok, data = pcall(readfile, CONFIG_PATH)
	if not ok or not data then return end
	local vals = {}
	for val in data:gmatch("([^|]+)") do table.insert(vals, val) end
	local filtered = {}
	for i, v in ipairs(vals) do
		if v ~= "" or (i > 1 and vals[i-1] ~= "") then
			table.insert(filtered, v)
		end
	end
	for i, key in ipairs(CONFIG_KEYS) do
		if filtered[i] then C[key] = filtered[i] end
	end
end

