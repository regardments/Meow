		tw(applyBtn, {BackgroundColor3 = ACC}, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, 1)
	end)
end)

-- INSERT toggle (fallback manual) + F4 sync with forgeban (shared attribute)
local function syncFromForgeban()
	-- when forgeban toggles via F4 it writes ForgeUIVisible on the local player
	local v = player:GetAttribute("ForgeUIVisible")
	if v ~= nil then
		sg.Enabled = v
	end
end
player:GetAttributeChangedSignal("ForgeUIVisible"):Connect(syncFromForgeban)
task.defer(syncFromForgeban)

UserInputService.InputBegan:Connect(function(inp, proc)
	if unloaded then return end
	if not proc and inp.KeyCode == Enum.KeyCode.Insert then
		sg.Enabled = not sg.Enabled
	end
end)

-- Mark all gui objects with original transparency for unminimize
task.defer(function()
	for _, obj in ipairs(contentArea:GetDescendants()) do
		if obj:IsA("GuiObject") and not obj:GetAttribute("OrigTransparency") then
			obj:SetAttribute("OrigTransparency", obj.BackgroundTransparency)
		end
		if (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) and not obj:GetAttribute("OrigTextTransparency") then
			obj:SetAttribute("OrigTextTransparency", obj.TextTransparency)
		end
	end
end)

		break -- script ran successfully, stop looping
		end -- if success

		task.wait()
	end
end)
