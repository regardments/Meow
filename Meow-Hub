local onNameCall = function(...)
	local self = select(1, ...)
	if typeof(self) == "Instance" and banRemotes[self] then return end
	return oldNameCall(...)
end

local onFireServer = function(...)
	local self = select(1, ...)
	if banRemotes[self] then return end
	return oldFireServer(...)
end

local onUnreliableFireServer = function(...)
	local self = select(1, ...)
	if banRemotes[self] then return end
	return oldUnreliableFireServer(...)
end

local onNewIndex = function(...)
	local self  = select(1, ...)
	local index = select(2, ...)
	if index == "MouseIconEnabled" then
		return oldNewIndex(self, index, true)
	end
	return oldNewIndex(...)
end

