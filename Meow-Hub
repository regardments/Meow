-- ── Tab switching ──────────────────────────────────────────────
local function switchTab(idx)
	if idx == selectedTab then return end
	selectedTab = idx

	for i, page in ipairs(pages) do
		page.Visible = (i == idx)
	end

	for i, btn in ipairs(tabBtns) do
		local icon = btn:FindFirstChild("Icon")
		local label = btn:FindFirstChild("Label")
		if i == idx then
			if icon then tw(icon, {TextColor3 = ACC}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0.2) end
			if label then tw(label, {TextColor3 = ACC}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0.2) end
			tw(tabIndicator, {Position = UDim2.new(0, 0, 0, 60 + (i - 1) * 46)}, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, 0.25)
		else
			if icon then tw(icon, {TextColor3 = TXT_DIM}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0.2) end
			if label then tw(label, {TextColor3 = TXT_DIM}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0.2) end
		end
	end
end

for i, btn in ipairs(tabBtns) do
	btn.MouseButton1Click:Connect(function() switchTab(i) end)
end

